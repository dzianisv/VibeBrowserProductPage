# dependencies
node_modules/

# next.js
.next/
out/

# production
build/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files
.env*

# vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# editors and operating systems
.DS_Store
.idea/
.vscode/

# backup data (contains PII)
old-waitlist-backup.json
tmp/
.netlify/

# Ephemeral self-signed cert for scripts/test-install-nonce.cjs apex->www TLS proxy
.test-tls/

# Ephemeral scratch tree for scripts/check-vercel-function-budget.cjs self-test
.vercel-budget-selftest-scratch/

# Local Supabase waitlist exports (contain PII — never commit)
.agents/backups/

# Demo video. Deliberately NOT in the repo — it lives in the `media-v1` GitHub
# Release and is served via dl.agentlabs.cc (see workers/dl-agentlabs-cdn and
# next.config.mjs). Keeping it out of Git is the whole point of #207: as LFS it
# billed visitor egress to the repo owner and, once that quota blew, it took
# production deploys down with it.
#
# For a local build/dev run, materialise the files an app serves itself with:
#   node scripts/media-assets.cjs fetch agentlabs
#   node scripts/media-assets.cjs fetch opencode-mobile
*.mp4
*.webm
